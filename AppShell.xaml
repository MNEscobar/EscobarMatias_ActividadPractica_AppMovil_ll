<?xml version="1.0" encoding="utf-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:EscobarMatias_ActividadPractica_AppMovil_ll.Views"
       x:Class="EscobarMatias_ActividadPractica_AppMovil_ll.AppShell"
       Title="Agenda de Contactos">

    <!--
        Las dos pantallas principales se muestran como pestañas (TabBar).
        ContactoModalPage y UsuarioApiDetallePage a propósito NO se declaran acá:
        solo se alcanzan navegando con Shell.Current.GoToAsync desde un ViewModel
        (sus rutas se registran en AppShell.xaml.cs).
    -->
    <TabBar>
        <ShellContent Title="Contactos"
                      ContentTemplate="{DataTemplate views:ContactosPage}"
                      Route="ContactosPage" />

        <ShellContent Title="Usuarios API"
                      ContentTemplate="{DataTemplate views:UsuariosPage}"
                      Route="UsuariosPage" />
    </TabBar>

</Shell>