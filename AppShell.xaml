<?xml version="1.0" encoding="utf-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:EscobarMatias_ActividadPractica_AppMovil_ll.Views"
       x:Class="EscobarMatias_ActividadPractica_AppMovil_ll.AppShell"
       Title="Agenda de Contactos">

    <!--
        ContactosPage es la única pantalla declarada acá como ShellContent:
        es la que se ve al abrir la app. ContactoModalPage a propósito NO se declara acá
        y solo se alcanza navegando con Shell.Current.GoToAsync desde el ViewModel.
    -->
    <ShellContent Title="Contactos"
                  ContentTemplate="{DataTemplate views:ContactosPage}"
                  Route="ContactosPage" />

</Shell>