<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:EscobarMatias_ActividadPractica_AppMovil_ll.ViewModels"
             xmlns:helpers="clr-namespace:EscobarMatias_ActividadPractica_AppMovil_ll.Helpers"
             x:Class="EscobarMatias_ActividadPractica_AppMovil_ll.Views.ContactoModalPage"
             x:DataType="vm:ContactoDetalleViewModel"
             Title="{Binding TituloPagina}"
             Shell.PresentationMode="ModalAnimated">

    <!--
        Shell.PresentationMode="ModalAnimated" es lo que hace que esta página
        se abra como modal (por arriba, con animación) en vez de apilarse en
        la navegación normal de Shell. Así, Agregar/Editar nunca "recargan"
        ni tapan la pantalla principal: aparecen encima y se cierran solas.
    -->

    <ContentPage.Resources>
        <helpers:StringToBoolConverter x:Key="StringToBoolConverter" />
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="4">

            <Label Text="Nombre" FontAttributes="Bold" />
            <Entry Placeholder="Ej: Juan Pérez"
                   Text="{Binding Nombre}" />
            <Label Text="{Binding ErrorNombre}"
                   TextColor="Red"
                   FontSize="12"
                   IsVisible="{Binding ErrorNombre, Converter={StaticResource StringToBoolConverter}}" />

            <Label Text="Teléfono" FontAttributes="Bold" Margin="0,12,0,0" />
            <Entry Placeholder="Ej: 342-5123456"
                   Text="{Binding Telefono}"
                   Keyboard="Telephone" />
            <Label Text="{Binding ErrorTelefono}"
                   TextColor="Red"
                   FontSize="12"
                   IsVisible="{Binding ErrorTelefono, Converter={StaticResource StringToBoolConverter}}" />

            <Label Text="Email" FontAttributes="Bold" Margin="0,12,0,0" />
            <Entry Placeholder="Ej: juan.perez@mail.com"
                   Text="{Binding Email}"
                   Keyboard="Email" />
            <Label Text="{Binding ErrorEmail}"
                   TextColor="Red"
                   FontSize="12"
                   IsVisible="{Binding ErrorEmail, Converter={StaticResource StringToBoolConverter}}" />

            <HorizontalStackLayout Spacing="12" Margin="0,24,0,0">
                <Button Text="Guardar" Command="{Binding GuardarCommand}" />
                <Button Text="Cancelar" Command="{Binding CancelarCommand}" BackgroundColor="Gray" />
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
